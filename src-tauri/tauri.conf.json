{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mantle",
  "version": "1.0.0",
  "identifier": "com.mantle.app",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm exec vite --config vite.renderer.config.mts --port 5173",
    "beforeBuildCommand": "pnpm exec vite build --config vite.renderer.config.mts --outDir dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Mantle",
        "width": 1280,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 14
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"]
  }
}
